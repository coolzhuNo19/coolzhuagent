<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="COOLZHU CODE Agent"
           Manufacturer="Coolzhu"
           Version="$(Version)"
           UpgradeCode="7873714F-87EE-4DFA-8AAB-2A2402B4ABEA"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 [ProductName]。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="CoolzhuAgent" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="COOLZHU CODE" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="LauncherComponent" Directory="INSTALLDIR" Guid="*">
      <File Id="LauncherExe"
            Source="$(PackageRoot)\COOLZHU-AGENT.exe"
            KeyPath="yes" />

      <Shortcut Id="StartMenuShortcut"
                Directory="AppMenuDir"
                Name="COOLZHU CODE Agent"
                Target="[INSTALLDIR]COOLZHU-AGENT.exe"
                WorkingDirectory="INSTALLDIR" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="COOLZHU CODE Agent"
                Target="[INSTALLDIR]COOLZHU-AGENT.exe"
                WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="RemoveAppMenuDir"
                    Directory="AppMenuDir"
                    On="uninstall" />
    </Component>

    <Feature Id="Main" Title="COOLZHU CODE Agent" Level="1">
      <ComponentRef Id="LauncherComponent" />
      <Files Directory="INSTALLDIR" Include="$(PackageRoot)\**">
        <Exclude Files="$(PackageRoot)\**\web-sessions*" />
        <Exclude Files="$(PackageRoot)\**\coolzhu.toml" />
        <Exclude Files="$(PackageRoot)\**\.env*" />
        <Exclude Files="$(PackageRoot)\**\*.sqlite" />
        <Exclude Files="$(PackageRoot)\**\*.sqlite3" />
        <Exclude Files="$(PackageRoot)\**\*.db" />
        <Exclude Files="$(PackageRoot)\.claw-todos.json" />
        <Exclude Files="$(PackageRoot)\COOLZHU-AGENT.exe" />
      </Files>
    </Feature>
  </Package>
</Wix>
