{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolzhuAgent",
  "version": "0.1.0",
  "identifier": "com.coolzhu.agent",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "single-instance": null
  }
}